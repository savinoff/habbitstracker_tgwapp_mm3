# Telegram bot token, полученный у @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram numeric user id владельца (узнать через @userinfobot)
OWNER_TELEGRAM_ID=

# Public URL, на который зарегистрирован webhook
APP_BASE_URL=https://your-domain.example

# Webhook URL (Telegram Bot API)
WEBHOOK_URL=https://your-domain.example/webhook/telegram

# TZ контейнера (для логов; пользовательский TZ — в БД)
TZ=UTC
