# Telegram bot token, полученный у @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram numeric user id владельца (узнать через @userinfobot)
OWNER_TELEGRAM_ID=

# Public URL, на который зарегистрирован webhook.
# spec:08-deploy.md#q9, q13
# Если Caddy на стандартном порту 443 → https://your-domain.example
# Если Caddy на нестандартном порту 8443 (v0.3.0+, когда 443 занят на хосте)
# → https://your-domain.example:8443
APP_BASE_URL=https://your-domain.example

# Webhook URL (Telegram Bot API)
WEBHOOK_URL=https://your-domain.example/webhook/telegram

# Email для ACME-регистрации (Let's Encrypt). Уведомления о сроке сертификата.
CADDY_EMAIL=you@example.com

# TZ контейнера (для логов; пользовательский TZ — в БД)
TZ=UTC
