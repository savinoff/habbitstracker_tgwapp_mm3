#!/bin/sh
# hooks/post-receive
# Срабатывает после git push в bare-репо. Делает checkout + rebuild + restart.
#
# spec:08-deploy.md#q4 — bare repo + post-receive hook
# spec:08-deploy.md#q13 — нестандартный порт (опционально)

set -euo pipefail

# v0.3.0: WORK_DIR по умолчанию в $HOME. Можно переопределить через env
# (HABITSTRACKER_WORK_DIR), если bare-repo и work tree живут в /srv и /opt.
WORK_DIR="${HABITSTRACKER_WORK_DIR:-$HOME/opt/habitstracker}"
BRANCH="main"

echo "▶ post-receive: deploy started"

# 1. Checkout.
echo "  - git checkout -f $BRANCH"
GIT_WORK_TREE="$WORK_DIR" git checkout -f "$BRANCH"
GIT_WORK_TREE="$WORK_DIR" git -C "$WORK_DIR" clean -fd
GIT_WORK_TREE="$WORK_DIR" git -C "$WORK_DIR" reset --hard "origin/$BRANCH"

# 2. Rebuild + restart.
cd "$WORK_DIR"
if [ -f .env ]; then
  set -- docker compose -f docker-compose.deploy.yml --env-file .env
else
  set -- docker compose -f docker-compose.deploy.yml
fi

echo "  - docker compose build"
"$@" build
echo "  - docker compose up -d"
"$@" up -d

echo "✅ post-receive: deploy finished"
